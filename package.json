{
  "name": "@markusberg/node-cache",
  "description": "Simple and fast NodeJS internal caching. Node internal in memory cache like memcached.",
  "keywords": [
    "cache",
    "caching",
    "local",
    "variable",
    "multi",
    "memory",
    "internal",
    "node",
    "memcached",
    "object"
  ],
  "tags": [
    "cache",
    "caching",
    "local",
    "variable",
    "multi",
    "memory",
    "internal",
    "node",
    "memcached",
    "object"
  ],
  "version": "6.0.0",
  "author": "mpneuried <mp@tcs.de>",
  "maintainers": [
    {
      "name": "M. Peter",
      "email": "mp@tcs.de",
      "url": "https://github.com/mpneuried"
    },
    {
      "name": "Joshy",
      "email": "erdiicodes@gmail.com",
      "url": "https://erdii.engineering/"
    }
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "homepage": "https://github.com/node-cache/node-cache",
  "repository": {
    "type": "git",
    "url": "git://github.com/node-cache/node-cache.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:prod",
    "build:prod": "tsc -p ./tsconfig.prod.json",
    "build:test": "tsc -p .",
    "clean": "rimraf dist *.tsbuildinfo coverage && mkdir -p dist coverage",
    "prep": "npm install && husky && chmod ug+x .husky/*",
    "prepublishOnly": "npm run build",
    "test": "npm run clean && npm run test:one",
    "test:one": "npm run build:test && mocha ./dist/node-cache.test.js -R spec",
    "test:watch": "npm run clean && nodemon -e ts -w ./src --exec 'npm run test:one'"
  },
  "dependencies": {
    "@markusberg/clone": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "(*.ts|*.md)": "prettier --write --check"
  }
}
